#include<stdio.h>
#include<math.h>
int main()
{
    int a,b,c,alpha,beeta,dis;
    printf("enter the co-efficients :");
    scanf("%d%d%d",&a,&b,&c);
    dis=(b*b-4*a*c);
    if(dis>=0)
        {
            alpha=(-b+sqrt(dis))/2*a;
            beeta=(-b-sqrt(dis))/2*a;
            printf("the roots are \nalpha=%d\nbeeta=%d",alpha,beeta);
        }
    else
    {
        printf("the roots are imaginary");
    }
 return 0;
}
